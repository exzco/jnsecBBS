# ==============================================================================
# 部署说明与生产变量机制：
# • 生产服务器的真实配置（READ_ONLY=false、生产数据库 DSN、站点域名等）保存在专属部署用户的 /home/gha_deploy/.pam_environment 中；
# • 只有当 GitHub Actions 以后台部署用户 gha_deploy 登录时，Linux PAM 模块才会自动注入这些生产变量；
# • run.sh 每次执行会执行 cp .env.example .env。切勿直接以 root 身份执行 run.sh，否则无法继承 gha_deploy 的 PAM 生产环境变量。
# ==============================================================================

MYSQL_ROOT_PASSWORD=123456

SITE_NAME=JNSEC BBS
SESSION_SECRET=fd19ec25c8913465de3e6d67c911950dc50af8205823b994077da989d72dce6c
COOKIE_SECURE=true
TRUSTED_ORIGINS=https://bbs.jnsec.org,https://new.bbs.jnsec.org
REGISTRATION=invite
APP_PORT=127.0.0.1:8080
TZ=Asia/Shanghai

ASSETS_DIR=/flarum/public/assets
APP_DB_DSN=bbs_go_ro:123456@tcp(mysql:3306)/bbs?charset=utf8mb4&parseTime=true&loc=UTC
READ_ONLY=true
