# ==============================================================================
# 部署说明与生产变量机制：
# 生产服务器的真实配置（READ_ONLY=false、生产数据库 DSN、站点域名等）保存在专属部署用户的 /home/gha_deploy/.pam_environment 中；
# 切勿直接以 root 身份执行 run.sh，否则无法继承 gha_deploy 的 PAM 生产环境变量。
# ==============================================================================

MYSQL_ROOT_PASSWORD=123456

SITE_NAME=JNSEC BBS
SESSION_SECRET=fd19ec25c8913465de3e6d67c911950dc50af8205823b994077da989d72dce6c
COOKIE_SECURE=true
TRUSTED_ORIGINS=https://bbs.jnsec.org,https://new.bbs.jnsec.org
REGISTRATION=invite
APP_PORT=127.0.0.1:8080
TZ=Asia/Shanghai

ASSETS_DIR=/flarum/public/assets
APP_DB_DSN=bbs_go_shared:123456@tcp(mysql:3306)/flarum?charset=utf8mb4&parseTime=true&loc=Local
READ_ONLY=false

# 站点对外访问地址：邮件通知里的链接前缀
SITE_URL=https://bbs.jnsec.org

# 邮件通知（SMTP）。host 与 from 任一留空 = 关闭邮件通知；465 = 隐式 TLS，587 = STARTTLS
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=noreply@jnsec.org
SMTP_PASSWORD=CHANGE-ME-smtp-auth-code
SMTP_FROM=noreply@jnsec.org
